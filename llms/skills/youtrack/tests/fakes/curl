#!/usr/bin/env bash

set -euo pipefail
: "${YOUTRACK_TEST_CURL_ARGUMENTS:?}"
: "${YOUTRACK_TEST_CURL_CALLS:?}"
readonly authorization_value="${YOUTRACK_AUTHORIZATION:-}"
readonly authorization_secret="${authorization_value##* }"
authorization_argument_leaked=false
lowercase_argument=''
printf 'call\n' >>"$YOUTRACK_TEST_CURL_CALLS"
{
    for argument in "$@"; do
        lowercase_argument="${argument,,}"
        if [[
            ( -n "$authorization_value" && "$argument" == *"$authorization_value"* ) ||
            ( -n "$authorization_secret" && "$argument" == *"$authorization_secret"* ) ||
            "$lowercase_argument" == *authorization:*
        ]]; then
            printf '%s\n' '[AUTHORIZATION ARGUMENT LEAK]'
            authorization_argument_leaked=true
            continue
        fi
        printf '%s\n' "$argument"
    done
} >>"$YOUTRACK_TEST_CURL_ARGUMENTS"
if [[ "$authorization_argument_leaked" == true ]]; then
    exit 1
fi
if [[ -n "${YOUTRACK_TEST_CURL_RESPONSE_FILE:-}" ]]; then
    cat "$YOUTRACK_TEST_CURL_RESPONSE_FILE"
fi
exit "${YOUTRACK_TEST_CURL_EXIT_STATUS:-0}"
